{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-acquisition-agent",
  "main": "src/index.js",
  "compatibility_date": "2026-11-23",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "AcquisitionContainer",
      "scheduling_policy": "durable_object",
      "instances": 1,
      "max_instances": 1,
      "instance_type": "basic",
      "images": {
        "base": { "dockerfile": "./Dockerfile" }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ACQUISITION_CONTAINER", "class_name": "AcquisitionContainer" }
    ]
  },
  "exports": {
    "AcquisitionContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
